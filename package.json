{
  "name": "build-detective",
  "displayName": "Build Detective for Buildkite",
  "description": "Find out why your build broke without leaving your editor — inspects failed CI jobs and explains them using Copilot, Cursor, or Claude",
  "version": "0.12.0",
  "publisher": "joesustaric",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Testing"
  ],
  "keywords": [
    "buildkite",
    "ci",
    "continuous integration",
    "build failure",
    "pipeline",
    "logs"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWorkspaceContains:.git"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "build-detective.openPanel",
        "title": "Build Detective: Open Panel"
      },
      {
        "command": "build-detective.openSidebar",
        "title": "Build Detective: Open Sidebar"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "buildDetectiveSidebar",
          "title": "Build Detective",
          "icon": "images/icon-activity-bar.svg"
        }
      ]
    },
    "views": {
      "buildDetectiveSidebar": [
        {
          "id": "buildDetectiveView",
          "name": "Jobs",
          "icon": "$(rocket)",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:ci": "xvfb-run -a pnpm test",
    "generate-icon": "node scripts/generate-icon.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.0.0",
    "@types/vscode": "^1.105.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^10.0.0",
    "sharp": "^0.35.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.59.2"
  },
  "packageManager": "pnpm@11.13.0"
}
